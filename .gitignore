# Dependencies
node_modules/
backend/node_modules/

# Environment configurations and secrets
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example

# SQLite Database files (ignore database binaries, preserve folder via .gitkeep)
backend/data/*.db
backend/data/*.db*
backend/data/*.sqlite
backend/data/*.sqlite3
backend/data/*.bak
!backend/data/.gitkeep

# Uploaded user media (preserve folder via .gitkeep)
backend/uploads/*
!backend/uploads/.gitkeep

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# IDE and Editor files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
